      "id": "2306e186-8d0d-4a6b-9ac0-72a8bc292347",
      "name": "Get pending album parts"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json)\n\nconst now = Date.now()\nconst quietPeriodMs = 10 * 1000\n\nconst groups = new Map()\n\nfor (const row of rows) {\n  if (!row.report_key) continue\n\n  if (!groups.has(row.report_key)) {\n    groups.set(row.report_key, [])\n  }\n\n  groups.get(row.report_key).push(row)\n}\n\nconst completedAlbums = []\n\nfor (const [reportKey, parts] of groups.entries()) {\n  parts.sort(\n    (a, b) => Number(a.message_id ?? 0) - Number(b.message_id ?? 0)\n  )\n\n  const receivedTimes = parts\n    .map(part => new Date(part.received_at).getTime())\n    .filter(Number.isFinite)\n\n  if (receivedTimes.length === 0) continue\n\n  const lastReceivedAt = Math.max(...receivedTimes)\n\n  // Если последнее фото пришло меньше 10 секунд назад,\n  // альбом пока считаем незавершённым\n  if (now - lastReceivedAt < quietPeriodMs) continue\n\n  const caption =\n    parts.find(\n      part =>\n        typeof part.caption === 'string' &&\n        part.caption.trim() !== ''\n    )?.caption.trim() ?? ''\n\n  const firstPart = parts[0]\n\n  completedAlbums.push({\n    json: {\n      report_key: reportKey,\n      chat_id: String(firstPart.chat_id ?? ''),\n      user_id: String(firstPart.user_id ?? ''),\n      media_group_id: String(firstPart.media_group_id ?? ''),\n      caption,\n      photo_count: parts.length,\npart_keys_json: JSON.stringify(\n  parts.map(part => part.part_key)\n),\nfile_ids_json: JSON.stringify(\n  parts.map(part => part.file_id)\n),\n      first_received_at: new Date(\n        Math.min(...receivedTimes)\n      ).toISOString(),\n      last_received_at: new Date(\n        lastReceivedAt\n      ).toISOString(),\n      assembled_at: new Date(now).toISOString(),\n      status: 'album_ready',\n    },\n  })\n}\n\nreturn completedAlbums"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
