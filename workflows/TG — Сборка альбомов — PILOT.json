    {
      "parameters": {
        "jsCode": "const item = $input.first().json\nconst text = String(item.caption ?? \u0027\u0027).trim()\nconst lines = text.split(/\\r?\\n/).map(line =\u003e line.trim()).filter(Boolean)\nconst missing = []\nconst namePattern = /^[А-ЯЁ][а-яё-]+\\s+[А-ЯЁ][а-яё-]+$/u\nconst studio = String(lines[0] ?? \u0027\u0027).toLowerCase().replace(/ё/g, \u0027е\u0027).replace(/[\\s-]+/g, \u0027 \u0027).trim()\nconst studios = new Set([\u0027жар птица\u0027, \u0027жп\u0027, \u0027гагаринский\u0027, \u0027гагарина\u0027, \u0027га\u0027, \u0027горького\u0027, \u0027го\u0027, \u0027счастье\u0027, \u0027сч\u0027, \u0027родионова\u0027, \u0027ро\u0027])\nif (!studios.has(studio)) missing.push(\u0027студия в первой строке\u0027)\nif (!namePattern.test(lines[1] ?? \u0027\u0027)) missing.push(\u0027имя и фамилия мастера во второй строке\u0027)\nif (!namePattern.test(lines[2] ?? \u0027\u0027)) missing.push(\u0027имя и фамилия клиента в третьей строке\u0027)\nconst beforeHeader = /(?:^|\\n)\\s*(?:описание до процедуры|до процедуры|до)\\s*(?::|—|-)\\s*/iu\nconst afterHeader = /(?:^|\\n)\\s*(?:описание после процедуры|описание процедуры|после снятия)\\s*(?::|—|-)\\s*/iu\nconst beforeMatch = beforeHeader.exec(text)\nconst afterMatch = afterHeader.exec(text)\nconst before = beforeMatch ? text.slice(beforeMatch.index + beforeMatch[0].length, afterMatch \u0026\u0026 afterMatch.index \u003e beforeMatch.index ? afterMatch.index : text.length).trim() : \u0027\u0027\nconst after = afterMatch ? text.slice(afterMatch.index + afterMatch[0].length).trim() : \u0027\u0027\nif (!before) missing.push(\u0027описание до процедуры\u0027)\nconst hasPreviousCoverage = /(?:наше|моё|мое|чужое|другого\\s+(?:салона|мастера)|без\\s+покрытия)/iu.test(before)\nif (!hasPreviousCoverage) missing.push(\u0027чьё покрытие было до процедуры\u0027)\nconst wearDurationPattern = /\\d+(?:[,.]\\d+)?\\s*(?:дн(?:ей|я)?|недел(?:я|и|ь)?|месяц(?:а|ев)?)/iu\nif (!wearDurationPattern.test(before)) missing.push(\u0027длительность носки\u0027)\nconst wearDescription = /(?:носил|отсло|скол|трещ|хорош|плох|идеал|нормал|проблем|поврежд|без\\s+отсло)/iu.test(before)\nif (!wearDescription) missing.push(\u0027как носилось покрытие\u0027)\nif (!after) missing.push(\u0027описание процедуры\u0027)\nif (!/ногтев[а-яё-]*\\s+пластин/iu.test(after)) missing.push(\u0027состояние ногтевой пластины после снятия\u0027)\nif (!/(?:^|[^а-яё])(?:[а-яё-]{3,}ли)(?=$|[^а-яё])/iu.test(after)) missing.push(\u0027что сделали во время процедуры\u0027)\nconst durationPattern = /(?:\\d+(?:[,.]\\d+)?\\s*(?:минут(?:а|ы)?|мин\\.?|час(?:а|ов)?|ч\\.?)(?:\\s+\\d+\\s*(?:минут(?:а|ы)?|мин\\.?))?|полтора\\s+часа)/iu\nif (!durationPattern.test(text)) missing.push(\u0027длительность процедуры\u0027)\nconst isValid = missing.length === 0\nreturn [{ json: { ...item, text_is_valid: isValid, missing_fields_text: missing.join(\u0027, \u0027), validation_status: isValid ? \u0027valid\u0027 : \u0027awaiting_text\u0027, validation_message: isValid ? \u0027✅ Отчёт заполнен полностью\u0027 : `Отчёт и фотографии получены, но в тексте не хватает данных:\\n\\n${missing.map(field =\u003e `• ${field}`).join(\u0027\\n\u0027)}\\n\\nОтправьте недостающие данные следующим сообщением. Повторно отправлять фотографии не нужно` } }]"
      },
      "type": "n8n-nodes-base.code",
