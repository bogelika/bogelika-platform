    {
      "parameters": {
        "jsCode": "const report = $json\n\nconst text = String(report.caption ?? report.report_text ?? '').trim()\n\nconst lines = text\n  .split(/\\r?\\n/)\n  .map(line => line.trim())\n  .filter(Boolean)\n\nconst normalize = value =>\n  String(value ?? '')\n    .toLowerCase()\n    .replace(/ё/g, 'е')\n    .replace(/[—–]/g, '-')\n    .replace(/\\s+/g, ' ')\n    .trim()\n\nconst normalizedText = normalize(text)\n\nconst detectStudio = () => {\n  if (/(^|[\\s\\n.,;:—-])жп($|[\\s\\n.,;:—-])|жар[\\s-]*птиц|жарптиц/iu.test(text)) {\n    return 'Жар-Птица'\n  }\n\n  if (/(^|[\\s\\n.,;:—-])га($|[\\s\\n.,;:—-])|гагаринск|гагарина/iu.test(text)) {\n    return 'Гагаринский'\n  }\n\n  if (/(^|[\\s\\n.,;:—-])го($|[\\s\\n.,;:—-])|горького|горкого/iu.test(text)) {\n    return 'Горького'\n  }\n\n  if (/(^|[\\s\\n.,;:—-])сч($|[\\s\\n.,;:—-])|счастье/iu.test(text)) {\n    return 'Счастье'\n  }\n\n  if (/(^|[\\s\\n.,;:—-])ро($|[\\s\\n.,;:—-])|родионова/iu.test(text)) {\n    return 'Родионова'\n  }\n\n  return ''\n}\n\nconst extractMaster = () => {\n  const byLabel = text.match(/(?:^|\\n)\\s*мастер\\s*[:\\-]?\\s*([А-ЯЁ][а-яё-]+\\s+[А-ЯЁ]\\.?)\\s*(?:\\n|$)/iu)\n  if (byLabel?.[1]) return byLabel[1].trim()\n\n  const line = lines.find(line =>\n    /^[А-ЯЁ][а-яё-]+\\s+[А-ЯЁ]\\.?$/u.test(line)\n  )\n\n  return line ?? ''\n}\n\nconst extractClient = () => {\n  const byLabel = text.match(/(?:^|\\n)\\s*клиент\\s*[:\\-]?\\s*([А-ЯЁ][а-яё-]+(?:\\s+[А-ЯЁ][а-яё-]+)?)\\s*(?:\\n|$)/iu)\n  if (byLabel?.[1]) return byLabel[1].trim()\n\n  if (\n    lines.length >= 3 &&\n    /^[А-ЯЁ][а-яё-]+(?:\\s+[А-ЯЁ][а-яё-]+)?$/u.test(lines[2])\n  ) {\n    return lines[2]\n  }\n\n  return ''\n}\n\nconst extractDuration = () => {\n  const match =\n    text.match(/\\d+[,.]?\\d*\\s*(?:минут|минута|минуты|мин\\.?|м\\.?|час|часа|часов|ч\\.?)/iu) ||\n    text.match(/полтора\\s+часа/iu)\n\n  return match?.[0]?.trim() ?? ''\n}\n\nconst now = new Date().toISOString()\n\nconst statusText =\n  report.validation_status === 'valid'\n    ? '✅ Полный'\n    : report.validation_status === 'incomplete'\n      ? '⚠️ Неполный'\n      : report.validation_status === 'awaiting_text'\n        ? '⏳ Ждёт дополнение'\n        : String(report.validation_status ?? '')\n\nreturn [\n  {\n    json: {\n      ...report,\n\n      'Дата создания': String(report.assembled_at ?? now),\n      'Дата обновления': now,\n      'Статус': statusText,\n      'Студия': detectStudio(),\n      'Мастер': extractMaster(),\n      'Клиент': extractClient(),\n      'Количество фото': Number(report.photo_count ?? 0),\n      'Текст отчёта': text,\n      'Недостающие данные': String(report.missing_fields_text ?? ''),\n      'Время выполнения': extractDuration(),\n      'report_key': String(report.report_key ?? ''),\n      'chat_id': String(report.chat_id ?? ''),\n      'user_id': String(report.user_id ?? ''),\n      'raw_file_ids': String(report.file_ids_json ?? ''),\n    },\n  },\n]"
      },
