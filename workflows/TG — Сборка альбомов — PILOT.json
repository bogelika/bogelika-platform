    {
      "parameters": {
        "jsCode": "const report = $json\nconst text = String(report.caption ?? report.report_text ?? \u0027\u0027).trim()\nconst lines = text.split(/\\r?\\n/).map(line =\u003e line.trim()).filter(Boolean)\nconst normalize = value =\u003e String(value ?? \u0027\u0027).toLowerCase().replace(/ё/g, \u0027е\u0027).replace(/[—–]/g, \u0027-\u0027).replace(/\\s+/g, \u0027 \u0027).trim()\nconst studioLine = normalize(lines[0]).replace(/-/g, \u0027 \u0027)\nconst studioMap = {\n  \u0027жар птица\u0027: \u0027Жар-Птица\u0027, \u0027жп\u0027: \u0027Жар-Птица\u0027,\n  \u0027гагаринский\u0027: \u0027Гагаринский\u0027, \u0027гагарина\u0027: \u0027Гагаринский\u0027, \u0027га\u0027: \u0027Гагаринский\u0027,\n  \u0027горького\u0027: \u0027Горького\u0027, \u0027го\u0027: \u0027Горького\u0027,\n  \u0027счастье\u0027: \u0027Счастье\u0027, \u0027сч\u0027: \u0027Счастье\u0027,\n  \u0027родионова\u0027: \u0027Родионова\u0027, \u0027ро\u0027: \u0027Родионова\u0027,\n}\nconst namePattern = /^[А-ЯЁ][а-яё-]+\\s+[А-ЯЁ][а-яё-]+$/u\nconst durationPattern = /(?:\\d+(?:[,.]\\d+)?\\s*(?:минут(?:а|ы)?|мин\\.?|час(?:а|ов)?|ч\\.?)(?:\\s+\\d+\\s*(?:минут(?:а|ы)?|мин\\.?))?|полтора\\s+часа)/giu\nconst durations = [...text.matchAll(durationPattern)].map(match =\u003e match[0].trim())\nconst now = new Date().toISOString()\nconst statusText = report.validation_status === \u0027valid\u0027 ? \u0027✅ Полный\u0027 : report.validation_status === \u0027incomplete\u0027 ? \u0027⚠️ Неполный\u0027 : report.validation_status === \u0027awaiting_text\u0027 ? \u0027⏳ Ждёт дополнение\u0027 : String(report.validation_status ?? \u0027\u0027)\nreturn [{ json: { ...report, \u0027Дата создания\u0027: String(report.assembled_at ?? now), \u0027Дата обновления\u0027: now, \u0027Статус\u0027: statusText, \u0027Студия\u0027: studioMap[studioLine] ?? \u0027\u0027, \u0027Мастер\u0027: namePattern.test(lines[1] ?? \u0027\u0027) ? lines[1] : \u0027\u0027, \u0027Клиент\u0027: namePattern.test(lines[2] ?? \u0027\u0027) ? lines[2] : \u0027\u0027, \u0027Количество фото\u0027: Number(report.photo_count ?? 0), \u0027Текст отчёта\u0027: text, \u0027Недостающие данные\u0027: String(report.missing_fields_text ?? \u0027\u0027), \u0027Время выполнения\u0027: durations.at(-1) ?? \u0027\u0027, \u0027report_key\u0027: String(report.report_key ?? \u0027\u0027), \u0027chat_id\u0027: String(report.chat_id ?? \u0027\u0027), \u0027user_id\u0027: String(report.user_id ?? \u0027\u0027), \u0027raw_file_ids\u0027: String(report.file_ids_json ?? \u0027\u0027) } }]"
      },
