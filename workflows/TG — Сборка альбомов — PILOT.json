    {
      "parameters": {
        "jsCode": "const item = $input.first().json\n\nconst text = String(item.caption ?? '').trim()\n\nconst lines = text\n  .split(/\\r?\\n/)\n  .map(line => line.trim())\n  .filter(Boolean)\n\nconst missing = []\n\nconst hasStudio =\n  /(^|[\\s\\n.,;:—-])(жп|га|го|сч|ро)($|[\\s\\n.,;:—-])/iu.test(text) ||\n  /жар[\\s-]*птиц|жарптиц|гагаринск|гагарина|горького|горкого|счастье|родионова/iu.test(text)\n\nif (!hasStudio) {\n  missing.push('студия')\n}\n\nconst hasMaster =\n  /(?:^|\\n)\\s*мастер\\s*[:\\-]?\\s*[А-ЯЁ][а-яё-]+\\s+[А-ЯЁ]\\.?\\s*(?:\\n|$)/iu.test(text) ||\n  lines.some(line =>\n    /^[А-ЯЁ][а-яё-]+\\s+[А-ЯЁ]\\.?$/u.test(line)\n  )\n\nif (!hasMaster) {\n  missing.push('имя мастера и первая буква фамилии')\n}\n\nconst hasClient =\n  /(?:^|\\n)\\s*клиент\\s*[:\\-]?\\s*[А-ЯЁ][а-яё-]+(?:\\s+[А-ЯЁ][а-яё-]+)?\\s*(?:\\n|$)/iu.test(text) ||\n  (\n    lines.length >= 3 &&\n    /^[А-ЯЁ][а-яё-]+(?:\\s+[А-ЯЁ][а-яё-]+)?$/u.test(lines[2])\n  )\n\nif (!hasClient) {\n  missing.push('имя клиента')\n}\n\nconst hasBase =\n  /работали\\s+базой|базой\\s*[:\\-]?\\s*\\S+|база\\s*[:\\-]?\\s*\\S+/iu.test(text)\n\nif (!hasBase) {\n  missing.push('название базы')\n}\n\nconst hasRepairs =\n  /ремонт|ремонты|ремонтов/iu.test(text)\n\nif (!hasRepairs) {\n  missing.push('информация о ремонтах')\n}\n\nconst hasFinalCoverage =\n  /(?:покрытие|цвет|лак)\\s*[:\\-]?\\s*(?!наше\\b|другого\\b|другой\\b|салона\\b)\\S+/iu.test(text) ||\n  /luxio|art-ex|artex|sota|neicha/iu.test(text)\n\nif (!hasFinalCoverage) {\n  missing.push('номер или название покрытия / цвета')\n}\n\nconst hasDuration =\n  /\\d+[,.]?\\d*\\s*(?:минут|минута|минуты|мин\\.?|м\\.?|час|часа|часов|ч\\.?)/iu.test(text) ||\n  /полтора\\s+часа/iu.test(text)\n\nif (!hasDuration) {\n  missing.push('время выполнения услуги')\n}\n\nconst isValid = missing.length === 0\n\nreturn [\n  {\n    json: {\n      ...item,\n      text_is_valid: isValid,\n      missing_fields_text: missing.join(', '),\n      validation_status: isValid\n        ? 'valid'\n        : 'awaiting_text',\n\n      validation_message: isValid\n        ? '✅ Отчёт заполнен полностью'\n        : `Отчёт и фотографии получены, но в тексте не хватает данных:\\n\\n${missing\n            .map(field => `• ${field}`)\n            .join('\\n')}\\n\\nОтправьте недостающие данные следующим сообщением. Повторно отправлять фотографии не нужно`,\n    },\n  },\n]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
